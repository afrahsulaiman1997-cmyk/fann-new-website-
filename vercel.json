{
  "headers": [
    {
      "source": "/(.*).(jpg|jpeg|png|webp|svg|avif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(woff2|woff|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/robots.txt", "destination": "/api/index?route=robots" },
    { "source": "/llms.txt", "destination": "/api/index?route=llms" },
    { "source": "/sitemap.xml", "destination": "/api/index?route=sitemap" },
    { "source": "/api/:path*", "destination": "/api/index" },
    {
      "source": "/((?!api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}